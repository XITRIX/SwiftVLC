+// AVSampleBufferDisplayLayer and AVSampleBufferVideoRenderer expose the
+// same queue and recovery operations. Keep all generation checks, notification
+// ownership, and flush/enqueue ordering on the selected object on both OS paths.
+@protocol SwiftVLCSampleBufferRendering <AVQueuedSampleBufferRendering>
+@property (nonatomic, readonly) AVQueuedSampleBufferRenderingStatus status;
+@property (nonatomic, readonly) BOOL requiresFlushToResumeDecoding;
+@property (nonatomic, readonly, nullable) NSError *error;
+@end
+
+static id<SwiftVLCSampleBufferRendering>
+DisplayLayerRenderer(AVSampleBufferDisplayLayer *displayLayer)
+{
+    if (@available(macOS 14.0, iOS 17.0, tvOS 17.0, visionOS 1.0, *))
+        return (id<SwiftVLCSampleBufferRendering>)displayLayer.sampleBufferRenderer;
+    return (id<SwiftVLCSampleBufferRendering>)displayLayer;
+}
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+static NSNotificationName DisplayLayerRequiresFlushNotification(void)
+{
+    if (@available(macOS 14.0, iOS 17.0, tvOS 17.0, visionOS 1.0, *))
+        return AVSampleBufferVideoRendererRequiresFlushToResumeDecodingDidChangeNotification;
+    return AVSampleBufferDisplayLayerRequiresFlushToResumeDecodingDidChangeNotification;
+}
+
+static NSNotificationName DisplayLayerDecodeFailureNotification(void)
+{
+    if (@available(macOS 14.0, iOS 17.0, tvOS 17.0, visionOS 1.0, *))
+        return AVSampleBufferVideoRendererDidFailToDecodeNotification;
+    return AVSampleBufferDisplayLayerFailedToDecodeNotification;
+}
